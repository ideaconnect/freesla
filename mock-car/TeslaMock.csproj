<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-targeted because the BLE peripheral role is only reachable through
       WinRT: Windows exposes no other way for a program to be a GATT server. The
       protocol core underneath imports nothing from WinRT, so the TCP transport
       works the same on any platform the runtime is ported to. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>teslamock</AssemblyName>
    <RootNamespace>TeslaMock</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
