{
  "name": "freesla",
  "version": "1.0.0",
  "description": "A Bluetooth key for Tesla vehicles, running on a Zepp OS watch.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "verify": "node tools/verify.js",
    "icons": "node tools/make-icons.js",
    "brand": "node tools/make-brand.js",
    "mock-car": "dotnet run --project mock-car --",
    "verify:mock-car": "dotnet build mock-car -v q --nologo && node tools/verify-mock-car.js"
  },
  "author": "IDCT (https://idct.tech)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ideaconnect/freesla"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@zeppos/device-types": "^3.0.0"
  },
  "dependencies": {
    "@zeppos/zml": "^0.0.43"
  }
}
